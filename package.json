{
  "name": "trackpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:web": "npm --prefix apps/web run dev",
    "build:web": "npm --prefix apps/web run build",
    "start:gateway": "ts-node services/gateway/server.ts"
  },
  "dependencies": {
    "@turf/turf": "^7.1.0",
    "fastify": "^4.28.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
