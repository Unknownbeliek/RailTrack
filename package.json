{
  "name": "trackpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client/*",
    "server/*"
  ],
  "scripts": {
    "dev": "echo 'Start both: npm run dev:server  and  npm run dev:client'",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "dev:server": "npm --prefix server run dev",
    "build:server": "npm --prefix server run build",
    "start:server": "npm --prefix server run start",
    "build": "npm run build:server && npm run build:client",



    "patch:speeds": "node scripts/patch-speeds.js",
    "build:tiles": "tippecanoe -o data/tiles/india-rail.pmtiles -Z4 -z14 --drop-densest-as-needed data/geojson/tracks-with-speed.geojson data/geojson/stations.geojson",
    "download:osm": "bash scripts/download-osm.sh"
  },
  "dependencies": {
    "@turf/turf": "^7.1.0",

    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
